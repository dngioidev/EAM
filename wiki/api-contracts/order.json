{
  "$schema": "../_schema/contract.schema.json",
  "module": "orders",
  "version": "1.0.0",
  "status": "approved",
  "createdAt": "2026-04-12",
  "updatedAt": "2026-04-12",
  "baseUrl": "/api/v1/orders",
  "description": "Order lifecycle endpoints — POS core flow. All orders are store-scoped via JWT. State machine: pending → processing → completed | cancelled.",
  "securityScheme": "BearerAuth",
  "businessRules": [
    "BR-ORDER-01: Price and tax rate are snapshotted on OrderItem at item-add time — not live from Product",
    "BR-ORDER-02: totalVnd = sum of (unitPriceVnd × quantity) — recalculated on every item mutation",
    "BR-ORDER-03: orderNumber auto-generated: {storePrefix}-{YYYYMMDD}-{seq:04d} unique per store per day",
    "BR-ORDER-04: Only the store's own cashier (cashierId = order.cashierId) OR store-manager may confirm payment",
    "BR-ORDER-05: Payment method recorded: 'cash' | 'card' — stored on order",
    "BR-ORDER-06: Order reaches 'completed' only after invoice is successfully issued",
    "BR-ORDER-07: Cancelled orders are terminal and kept for audit — no hard delete",
    "BR-ORDER-08: Cashier list view returns only their own orders (cashierId = caller.id)",
    "BR-ORDER-09: Pagination page size default 20",
    "BR-ORDER-10: Adding the same productId twice increments quantity (upsert, not duplicate rows)",
    "BR-ORDER-11: Adding item with quantity = 0 removes the item from the order",
    "BR-ORDER-12: Items cannot be added to an order that is not in 'pending' state",
    "BR-ORDER-13: Deactivated products cannot be added to an order",
    "BR-ORDER-14: storeId ALWAYS sourced from JWT — never from request body"
  ],
  "endpoints": [
    {
      "id": "ORDER-01",
      "method": "POST",
      "path": "/",
      "auth": "bearer",
      "roles": ["cashier", "store-manager"],
      "summary": "Create a new empty order for the caller's store",
      "request": {
        "body": null
      },
      "responses": {
        "201": {
          "description": "Order created in 'pending' state",
          "schema": {
            "data": {
              "id": { "type": "string", "format": "uuid" },
              "orderNumber": { "type": "string", "example": "STR1-20260512-0001" },
              "status": { "type": "string", "enum": ["pending"] },
              "totalVnd": { "type": "integer", "example": 0 },
              "paymentMethod": { "type": "null" },
              "storeId": { "type": "string", "format": "uuid" },
              "cashierId": { "type": "string", "format": "uuid" },
              "items": { "type": "array", "items": {} },
              "createdAt": { "type": "string", "format": "date-time" },
              "updatedAt": { "type": "string", "format": "date-time" }
            }
          }
        },
        "401": { "description": "Not authenticated" },
        "403": { "description": "Role not permitted" }
      }
    },
    {
      "id": "ORDER-02",
      "method": "POST",
      "path": "/:id/items",
      "auth": "bearer",
      "roles": ["cashier", "store-manager"],
      "summary": "Add or update a product in the order cart. Quantity 0 removes item.",
      "request": {
        "params": { "id": { "type": "string", "format": "uuid", "description": "Order ID" } },
        "body": {
          "contentType": "application/json",
          "schema": {
            "productId": { "type": "string", "format": "uuid", "required": true },
            "quantity": { "type": "integer", "minimum": 0, "required": true, "description": "0 removes item" }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Order updated with new item. totalVnd recalculated.",
          "schema": { "data": { "$ref": "ORDER-01 response data" } }
        },
        "400": { "description": "Product deactivated, or quantity negative" },
        "404": { "description": "Order not found, or product not in caller's store" },
        "409": { "description": "Order not in pending state" }
      }
    },
    {
      "id": "ORDER-03",
      "method": "POST",
      "path": "/:id/confirm-payment",
      "auth": "bearer",
      "roles": ["cashier", "store-manager"],
      "summary": "Confirm payment — advances order from pending to processing, triggers invoice generation",
      "request": {
        "params": { "id": { "type": "string", "format": "uuid" } },
        "body": {
          "contentType": "application/json",
          "schema": {
            "paymentMethod": { "type": "string", "enum": ["cash", "card"], "required": true }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Order status set to 'processing'. Invoice generation triggered async.",
          "schema": { "data": { "$ref": "ORDER-01 response data with status=processing" } }
        },
        "400": { "description": "Order has no items" },
        "403": { "description": "Caller is not the order's cashier or a store-manager" },
        "404": { "description": "Order not found" },
        "409": { "description": "Order not in pending state" }
      }
    },
    {
      "id": "ORDER-04",
      "method": "POST",
      "path": "/:id/cancel",
      "auth": "bearer",
      "roles": ["cashier", "store-manager"],
      "summary": "Cancel a pending order",
      "request": {
        "params": { "id": { "type": "string", "format": "uuid" } },
        "body": null
      },
      "responses": {
        "200": {
          "description": "Order status set to 'cancelled'",
          "schema": { "data": { "$ref": "ORDER-01 response data with status=cancelled" } }
        },
        "403": { "description": "Forbidden — not the order's cashier or store-manager" },
        "404": { "description": "Order not found" },
        "409": { "description": "Order is not in cancellable state (processing|completed|refunded)" }
      }
    },
    {
      "id": "ORDER-05",
      "method": "GET",
      "path": "/",
      "auth": "bearer",
      "roles": ["admin", "store-manager", "cashier", "accountant", "viewer"],
      "summary": "List orders. Cashier sees own orders only. Manager+ sees all store orders.",
      "request": {
        "query": {
          "status": { "type": "string", "enum": ["pending", "processing", "completed", "cancelled", "refunded"], "required": false },
          "from": { "type": "string", "format": "date", "required": false, "description": "createdAt >= from" },
          "to": { "type": "string", "format": "date", "required": false, "description": "createdAt <= to" },
          "cashierId": { "type": "string", "format": "uuid", "required": false, "description": "Manager/admin filter by cashier" },
          "page": { "type": "integer", "default": 1, "required": false },
          "limit": { "type": "integer", "default": 20, "maximum": 100, "required": false }
        }
      },
      "responses": {
        "200": {
          "description": "Paginated order list",
          "schema": {
            "data": {
              "items": { "type": "array" },
              "total": { "type": "integer" },
              "page": { "type": "integer" },
              "limit": { "type": "integer" }
            }
          }
        }
      }
    },
    {
      "id": "ORDER-06",
      "method": "GET",
      "path": "/:id",
      "auth": "bearer",
      "roles": ["admin", "store-manager", "cashier", "accountant", "viewer"],
      "summary": "Get order by ID with all items",
      "request": {
        "params": { "id": { "type": "string", "format": "uuid" } }
      },
      "responses": {
        "200": {
          "description": "Full order with items array",
          "schema": { "data": { "$ref": "ORDER-01 response data" } }
        },
        "403": { "description": "Cashier accessing another cashier's order" },
        "404": { "description": "Order not found or different store" }
      }
    },
    {
      "id": "ORDER-07",
      "method": "GET",
      "path": "/:id/invoice",
      "auth": "bearer",
      "roles": ["admin", "store-manager", "cashier", "accountant", "viewer"],
      "summary": "Get the invoice for a completed order",
      "request": {
        "params": { "id": { "type": "string", "format": "uuid" } }
      },
      "responses": {
        "200": { "description": "Invoice document for the order" },
        "404": { "description": "Order not found, or invoice not yet issued (order not completed)" }
      }
    }
  ]
}

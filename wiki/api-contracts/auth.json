{
  "$schema": "../_schema/contract.schema.json",
  "module": "auth",
  "version": "1.1.0",
  "status": "approved",
  "createdAt": "2026-04-12",
  "updatedAt": "2026-04-13",
  "baseUrl": "/api/v1/auth",
  "description": "Authentication endpoints — JWT access + refresh token pair, Redis-backed rotation",
  "securityScheme": "BearerAuth",
  "businessRules": [
    "BR-AUTH-08: Same 401 error for wrong password AND unknown email (no user enumeration)",
    "BR-AUTH-01: bcrypt cost = 12",
    "BR-AUTH-02: Access token expires in 15 min",
    "BR-AUTH-03: Refresh token expires in 7 days, stored in Redis key refresh:{userId}",
    "BR-AUTH-04: Every refresh call MUST rotate the token (delete old key, issue new)",
    "BR-AUTH-05: Deactivated user account → 401 on any protected endpoint",
    "BR-AUTH-06: GET /me performs a live DB check, not just JWT decoding",
    "BR-ADMIN-01: Only admin role can access /auth/users, POST /auth/register, PATCH /auth/users/:id/deactivate",
    "BR-ADMIN-03: Deactivating a user MUST flush their Redis refresh token (del refresh:{userId}) before setting isActive=false",
    "BR-ADMIN-04: Users with role != admin MUST have a non-null storeId"
  ],
  "endpoints": [
    {
      "id": "AUTH-01",
      "method": "POST",
      "path": "/login",
      "auth": "public",
      "summary": "Login with email and password",
      "request": {
        "body": {
          "contentType": "application/json",
          "schema": {
            "email": { "type": "string", "format": "email", "required": true },
            "password": { "type": "string", "minLength": 8, "required": true }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Login successful",
          "schema": {
            "data": {
              "accessToken": { "type": "string" },
              "refreshToken": { "type": "string" },
              "user": {
                "id": { "type": "string", "format": "uuid" },
                "email": { "type": "string" },
                "name": { "type": "string" },
                "role": { "type": "string", "enum": ["admin", "store-manager", "cashier", "accountant", "viewer"] },
                "storeId": { "type": "string", "format": "uuid", "nullable": true }
              }
            },
            "meta": { "timestamp": { "type": "string", "format": "date-time" } }
          }
        },
        "401": {
          "description": "Invalid credentials — same message for wrong password and unknown email",
          "schema": {
            "statusCode": 401,
            "message": "Invalid credentials",
            "timestamp": { "type": "string" },
            "path": { "type": "string" }
          }
        }
      }
    },
    {
      "id": "AUTH-02",
      "method": "POST",
      "path": "/refresh",
      "auth": "public",
      "summary": "Refresh access token using refresh token — rotates the token",
      "request": {
        "body": {
          "contentType": "application/json",
          "schema": {
            "refreshToken": { "type": "string", "required": true }
          }
        }
      },
      "responses": {
        "200": {
          "description": "New token pair issued, old refresh token invalidated in Redis",
          "schema": {
            "data": {
              "accessToken": { "type": "string" },
              "refreshToken": { "type": "string" },
              "user": {
                "id": { "type": "string", "format": "uuid" },
                "email": { "type": "string" },
                "name": { "type": "string" },
                "role": { "type": "string" },
                "storeId": { "type": "string", "nullable": true }
              }
            },
            "meta": { "timestamp": { "type": "string" } }
          }
        },
        "401": {
          "description": "Invalid or expired refresh token"
        }
      }
    },
    {
      "id": "AUTH-03",
      "method": "POST",
      "path": "/logout",
      "auth": "bearer",
      "summary": "Logout — deletes refresh token from Redis",
      "request": { "body": null },
      "responses": {
        "204": {
          "description": "Logged out — refresh token invalidated"
        },
        "401": { "description": "Not authenticated" }
      }
    },
    {
      "id": "AUTH-04",
      "method": "GET",
      "path": "/me",
      "auth": "bearer",
      "summary": "Get current user profile — performs live DB lookup",
      "request": { "body": null },
      "responses": {
        "200": {
          "description": "Current user profile",
          "schema": {
            "data": {
              "id": { "type": "string", "format": "uuid" },
              "email": { "type": "string" },
              "name": { "type": "string" },
              "role": { "type": "string" },
              "storeId": { "type": "string", "nullable": true },
              "isActive": { "type": "boolean" },
              "createdAt": { "type": "string", "format": "date-time" }
            },
            "meta": { "timestamp": { "type": "string" } }
          }
        },
        "401": { "description": "Not authenticated" }
      }
    },
    {
      "id": "AUTH-05",
      "method": "GET",
      "path": "/users",
      "auth": "bearer",
      "roles": ["admin"],
      "summary": "[Admin] List all users in the system",
      "request": { "body": null },
      "responses": {
        "200": {
          "description": "Array of user objects",
          "schema": {
            "data": [
              {
                "id": { "type": "string", "format": "uuid" },
                "email": { "type": "string" },
                "name": { "type": "string" },
                "role": { "type": "string", "enum": ["admin", "store-manager", "cashier", "accountant", "viewer"] },
                "storeId": { "type": "string", "format": "uuid", "nullable": true },
                "isActive": { "type": "boolean" },
                "createdAt": { "type": "string", "format": "date-time" },
                "updatedAt": { "type": "string", "format": "date-time" }
              }
            ],
            "meta": { "timestamp": { "type": "string", "format": "date-time" } }
          }
        },
        "401": { "description": "Not authenticated" },
        "403": { "description": "Forbidden — admin only" }
      }
    },
    {
      "id": "AUTH-06",
      "method": "POST",
      "path": "/register",
      "auth": "bearer",
      "roles": ["admin"],
      "summary": "[Admin] Create a new user account",
      "request": {
        "body": {
          "contentType": "application/json",
          "schema": {
            "email": { "type": "string", "format": "email", "required": true },
            "password": { "type": "string", "minLength": 8, "required": true },
            "name": { "type": "string", "minLength": 1, "required": true },
            "role": { "type": "string", "enum": ["admin", "store-manager", "cashier", "accountant", "viewer"], "required": true },
            "storeId": { "type": "string", "format": "uuid", "nullable": true, "description": "Required for non-admin roles (BR-ADMIN-04)" }
          }
        }
      },
      "responses": {
        "201": {
          "description": "User created — returns new user object (no password hash)",
          "schema": {
            "data": {
              "id": { "type": "string", "format": "uuid" },
              "email": { "type": "string" },
              "name": { "type": "string" },
              "role": { "type": "string" },
              "storeId": { "type": "string", "nullable": true },
              "isActive": { "type": "boolean" },
              "createdAt": { "type": "string", "format": "date-time" }
            }
          }
        },
        "401": { "description": "Not authenticated" },
        "403": { "description": "Forbidden — admin only" },
        "409": { "description": "Email already registered" }
      }
    },
    {
      "id": "AUTH-07",
      "method": "PATCH",
      "path": "/users/:id/deactivate",
      "auth": "bearer",
      "roles": ["admin"],
      "summary": "[Admin] Deactivate a user — flushes their Redis session immediately",
      "request": { "body": null },
      "params": {
        "id": { "type": "string", "format": "uuid", "required": true }
      },
      "responses": {
        "200": {
          "description": "User deactivated — isActive set to false, refresh token deleted from Redis",
          "schema": {
            "data": {
              "id": { "type": "string", "format": "uuid" },
              "email": { "type": "string" },
              "isActive": { "type": "boolean", "example": false }
            }
          }
        },
        "401": { "description": "Not authenticated" },
        "403": { "description": "Forbidden — admin only" },
        "404": { "description": "User not found" }
      }
    }
  ]
}

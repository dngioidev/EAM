{
  "$schema": "../_schema/contract.schema.json",
  "module": "stores",
  "version": "1.0.0",
  "status": "approved",
  "createdAt": "2026-04-12",
  "updatedAt": "2026-04-12",
  "baseUrl": "/api/v1/stores",
  "description": "Store management endpoints — admin creates/manages stores, non-admin accesses own store only",
  "securityScheme": "BearerAuth",
  "businessRules": [
    "BR-STORE-01: taxCode format = /^\\d{10}(-\\d{3})?$/ — validated at creation",
    "BR-STORE-02: taxCode is immutable after creation — PATCH with taxCode → 400",
    "BR-STORE-03: storeId ALWAYS sourced from JWT, NEVER from URL or body",
    "BR-STORE-04: Soft-delete only — records are never physically deleted",
    "BR-STORE-05: Deactivating a store immediately revokes all user sessions (Redis flush)",
    "BR-STORE-06: Only the 'admin' role can create, list all, update, or deactivate stores",
    "BR-STORE-07: All roles can GET /stores/me (own store)"
  ],
  "endpoints": [
    {
      "id": "STORE-01",
      "method": "POST",
      "path": "/",
      "auth": "bearer",
      "roles": ["admin"],
      "summary": "Create a new store",
      "request": {
        "body": {
          "contentType": "application/json",
          "schema": {
            "name": { "type": "string", "minLength": 1, "required": true },
            "taxCode": { "type": "string", "pattern": "^\\d{10}(-\\d{3})?$", "required": true },
            "address": { "type": "string", "required": false }
          }
        }
      },
      "responses": {
        "201": {
          "description": "Store created",
          "schema": {
            "data": {
              "id": { "type": "string", "format": "uuid" },
              "name": { "type": "string" },
              "taxCode": { "type": "string" },
              "address": { "type": "string", "nullable": true },
              "isActive": { "type": "boolean" },
              "createdAt": { "type": "string", "format": "date-time" },
              "updatedAt": { "type": "string", "format": "date-time" }
            },
            "meta": { "timestamp": { "type": "string" } }
          }
        },
        "400": { "description": "Validation error (invalid taxCode format)" },
        "401": { "description": "Not authenticated" },
        "403": { "description": "Forbidden — admin role required" },
        "409": { "description": "Tax code already registered" }
      }
    },
    {
      "id": "STORE-02",
      "method": "GET",
      "path": "/",
      "auth": "bearer",
      "roles": ["admin"],
      "summary": "List all stores (admin only)",
      "request": { "body": null },
      "responses": {
        "200": {
          "description": "Array of all stores ordered by createdAt DESC",
          "schema": {
            "data": {
              "type": "array",
              "items": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "taxCode": { "type": "string" },
                "address": { "type": "string", "nullable": true },
                "isActive": { "type": "boolean" },
                "createdAt": { "type": "string" },
                "updatedAt": { "type": "string" }
              }
            },
            "meta": { "timestamp": { "type": "string" } }
          }
        },
        "401": { "description": "Not authenticated" },
        "403": { "description": "Forbidden — admin role required" }
      }
    },
    {
      "id": "STORE-03",
      "method": "GET",
      "path": "/me",
      "auth": "bearer",
      "roles": ["admin", "store-manager", "cashier", "accountant", "viewer"],
      "summary": "Get current user's own store (storeId from JWT)",
      "request": { "body": null },
      "responses": {
        "200": {
          "description": "Own store details",
          "schema": {
            "data": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "taxCode": { "type": "string" },
              "address": { "type": "string", "nullable": true },
              "isActive": { "type": "boolean" }
            },
            "meta": { "timestamp": { "type": "string" } }
          }
        },
        "401": { "description": "Not authenticated" },
        "404": { "description": "Store not found (user not assigned to a store)" }
      }
    },
    {
      "id": "STORE-04",
      "method": "PATCH",
      "path": "/:id",
      "auth": "bearer",
      "roles": ["admin"],
      "summary": "Update store name/address — taxCode is immutable (400 if included)",
      "request": {
        "params": { "id": { "type": "string", "format": "uuid" } },
        "body": {
          "contentType": "application/json",
          "schema": {
            "name": { "type": "string", "required": false },
            "address": { "type": "string", "required": false },
            "taxCode": { "description": "FORBIDDEN — will return 400 if present" }
          }
        }
      },
      "responses": {
        "200": { "description": "Updated store" },
        "400": { "description": "taxCode cannot be changed after store creation" },
        "401": { "description": "Not authenticated" },
        "403": { "description": "Forbidden — admin role required" },
        "404": { "description": "Store not found" }
      }
    },
    {
      "id": "STORE-05",
      "method": "PATCH",
      "path": "/:id/deactivate",
      "auth": "bearer",
      "roles": ["admin"],
      "summary": "Deactivate a store — revokes all user sessions immediately",
      "request": {
        "params": { "id": { "type": "string", "format": "uuid" } },
        "body": null
      },
      "responses": {
        "200": { "description": "Store deactivated, all user Redis refresh keys flushed" },
        "401": { "description": "Not authenticated" },
        "403": { "description": "Forbidden — admin role required" },
        "404": { "description": "Store not found" }
      }
    }
  ]
}

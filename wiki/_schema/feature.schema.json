{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "feature.schema.json",
  "title": "Feature Specification Schema",
  "type": "object",
  "required": ["meta", "quick_facts", "content", "audit"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["version", "last_updated", "title", "owner"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "last_updated": { "type": "string", "format": "date" },
        "title": { "type": "string" },
        "owner": { "type": "string", "description": "Skill name that owns this file" }
      }
    },
    "quick_facts": {
      "type": "object",
      "required": ["feature_id", "status", "sprint", "priority"],
      "properties": {
        "feature_id": { "type": "string", "pattern": "^FEAT-\\d+$", "example": "FEAT-001" },
        "status": { "type": "string", "enum": ["draft", "ready", "in-progress", "done", "deprecated"] },
        "sprint": { "type": "string" },
        "priority": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
        "linked_contracts": { "type": "array", "items": { "type": "string" } }
      }
    },
    "content": {
      "type": "object",
      "required": ["tldr", "as_a", "i_want", "so_that", "acceptance_criteria"],
      "properties": {
        "tldr": { "type": "string" },
        "as_a": { "type": "string" },
        "i_want": { "type": "string" },
        "so_that": { "type": "string" },
        "acceptance_criteria": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "out_of_scope": { "type": "array", "items": { "type": "string" } },
        "ui_notes": { "type": "string" },
        "business_rules": { "type": "array", "items": { "type": "string" } }
      }
    },
    "audit": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["version", "timestamp", "author", "action", "note"],
        "properties": {
          "version": { "type": "integer" },
          "timestamp": { "type": "string", "format": "date-time" },
          "author": { "type": "string" },
          "action": { "type": "string", "enum": ["created", "updated", "deprecated"] },
          "note": { "type": "string" }
        }
      }
    }
  }
}

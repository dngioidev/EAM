{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "decision.schema.json",
  "title": "Architecture Decision Record Schema",
  "type": "object",
  "required": ["meta", "quick_facts", "content", "audit"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["version", "last_updated", "title", "owner"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "last_updated": { "type": "string", "format": "date" },
        "title": { "type": "string" },
        "owner": { "type": "string" }
      }
    },
    "quick_facts": {
      "type": "object",
      "required": ["decision_id", "status", "date", "deciders"],
      "properties": {
        "decision_id": { "type": "string", "pattern": "^ADR-\\d+$" },
        "status": { "type": "string", "enum": ["proposed", "accepted", "deprecated", "superseded"] },
        "date": { "type": "string", "format": "date" },
        "deciders": { "type": "array", "items": { "type": "string" } },
        "supersedes": { "type": "string", "pattern": "^ADR-\\d+$" }
      }
    },
    "content": {
      "type": "object",
      "required": ["context", "decision", "consequences"],
      "properties": {
        "context": { "type": "string" },
        "decision": { "type": "string" },
        "options_considered": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["option", "pros", "cons"],
            "properties": {
              "option": { "type": "string" },
              "pros": { "type": "array", "items": { "type": "string" } },
              "cons": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "consequences": { "type": "string" }
      }
    },
    "audit": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["version", "timestamp", "author", "action", "note"],
        "properties": {
          "version": { "type": "integer" },
          "timestamp": { "type": "string", "format": "date-time" },
          "author": { "type": "string" },
          "action": { "type": "string", "enum": ["created", "updated", "deprecated", "superseded"] },
          "note": { "type": "string" }
        }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "contract.schema.json",
  "title": "API Contract Schema",
  "type": "object",
  "required": ["meta", "quick_facts", "content", "audit"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["version", "last_updated", "title", "owner"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "last_updated": { "type": "string", "format": "date" },
        "title": { "type": "string" },
        "owner": { "type": "string" }
      }
    },
    "quick_facts": {
      "type": "object",
      "required": ["contract_id", "status", "method", "path", "auth_required"],
      "properties": {
        "contract_id": { "type": "string", "pattern": "^API-\\d+$" },
        "status": { "type": "string", "enum": ["draft", "approved", "implemented", "deprecated"] },
        "method": { "type": "string", "enum": ["GET", "POST", "PATCH", "DELETE"] },
        "path": { "type": "string", "description": "e.g. /api/v1/products" },
        "auth_required": { "type": "boolean" },
        "roles_allowed": { "type": "array", "items": { "type": "string" } },
        "linked_feature": { "type": "string", "pattern": "^FEAT-\\d+$" }
      }
    },
    "content": {
      "type": "object",
      "required": ["description", "request", "response_success"],
      "properties": {
        "description": { "type": "string" },
        "request": {
          "type": "object",
          "properties": {
            "headers": { "type": "object" },
            "params": { "type": "object" },
            "query": { "type": "object" },
            "body": { "type": "object" }
          }
        },
        "response_success": {
          "type": "object",
          "required": ["status_code", "body"],
          "properties": {
            "status_code": { "type": "integer" },
            "body": { "type": "object" }
          }
        },
        "response_errors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["status_code", "error_code", "description"],
            "properties": {
              "status_code": { "type": "integer" },
              "error_code": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        }
      }
    },
    "audit": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["version", "timestamp", "author", "action", "note"],
        "properties": {
          "version": { "type": "integer" },
          "timestamp": { "type": "string", "format": "date-time" },
          "author": { "type": "string" },
          "action": { "type": "string", "enum": ["created", "updated", "approved", "deprecated"] },
          "note": { "type": "string" }
        }
      }
    }
  }
}

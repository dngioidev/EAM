{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "bug.schema.json",
  "title": "Bug Report Schema",
  "type": "object",
  "required": ["meta", "quick_facts", "content", "audit"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["version", "last_updated", "title", "owner"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "last_updated": { "type": "string", "format": "date" },
        "title": { "type": "string" },
        "owner": { "type": "string" }
      }
    },
    "quick_facts": {
      "type": "object",
      "required": ["bug_id", "severity", "status", "sprint"],
      "properties": {
        "bug_id": { "type": "string", "pattern": "^BUG-\\d+$" },
        "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
        "status": { "type": "string", "enum": ["open", "in-progress", "fixed", "verified", "wont-fix"] },
        "sprint": { "type": "string" },
        "linked_feature": { "type": "string", "pattern": "^FEAT-\\d+$" }
      }
    },
    "content": {
      "type": "object",
      "required": ["tldr", "steps_to_reproduce", "expected_behavior", "actual_behavior"],
      "properties": {
        "tldr": { "type": "string" },
        "environment": { "type": "string" },
        "steps_to_reproduce": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "expected_behavior": { "type": "string" },
        "actual_behavior": { "type": "string" },
        "root_cause": { "type": "string" },
        "fix_description": { "type": "string" }
      }
    },
    "audit": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["version", "timestamp", "author", "action", "note"],
        "properties": {
          "version": { "type": "integer" },
          "timestamp": { "type": "string", "format": "date-time" },
          "author": { "type": "string" },
          "action": { "type": "string", "enum": ["created", "updated", "fixed", "wont-fix"] },
          "note": { "type": "string" }
        }
      }
    }
  }
}

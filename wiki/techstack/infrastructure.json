{
  "meta": {
    "version": 1,
    "last_updated": "2025-01-01",
    "title": "Infrastructure Stack",
    "owner": "vibe-devops-general"
  },
  "quick_facts": {
    "containerization": "Docker + Docker Compose",
    "ci_cd": "GitHub Actions",
    "services_count": 6
  },
  "content": {
    "services": [
      {
        "name": "postgres",
        "image": "postgres:15-alpine",
        "port": 5432,
        "purpose": "Primary database for backend"
      },
      {
        "name": "postgres-test",
        "image": "postgres:15-alpine",
        "port": 5433,
        "purpose": "Isolated test database (never shared with dev data)"
      },
      {
        "name": "redis",
        "image": "redis:7-alpine",
        "port": 6379,
        "purpose": "Caching + session storage"
      },
      {
        "name": "backend",
        "image": "eam/backend",
        "port": 3000,
        "purpose": "NestJS API server"
      },
      {
        "name": "frontend",
        "image": "eam/frontend",
        "port": 5173,
        "purpose": "React + Vite dev server (development only)"
      },
      {
        "name": "wiki",
        "image": "eam/wiki",
        "port": 3001,
        "purpose": "Next.js wiki viewer"
      }
    ],
    "volumes": [
      { "name": "postgres_data", "mounted_to": "postgres:/var/lib/postgresql/data" },
      { "name": "redis_data", "mounted_to": "redis:/data" }
    ],
    "networks": [
      { "name": "eam-net", "driver": "bridge", "purpose": "All services communicate over this single network" }
    ]
  },
  "audit": [
    {
      "version": 1,
      "timestamp": "2025-01-01T00:00:00Z",
      "author": "vibe-devops-general",
      "action": "created",
      "note": "Initial infrastructure definition"
    }
  ]
}

  },
  "quick_facts": {
    "status": "locked",
    "review_cadence": "quarterly or on major version release"
  },
  "content": {
    "tldr": "Stack is locked. Changes require ADR + vibe-project-manager approval before any code is written.",
    "decisions": [
      {
        "category": "Backend Framework",
        "chosen": "NestJS 10.x",
        "alternatives_rejected": ["Express.js", "Fastify"],
        "reason": "Built-in DI, TypeScript-first, modular architecture, strong convention for teams."
      },
      {
        "category": "ORM",
        "chosen": "TypeORM 0.3.x",
        "alternatives_rejected": ["Prisma", "Drizzle"],
        "reason": "Deep NestJS integration, migration support, QueryBuilder for complex queries."
      },
      {
        "category": "Database",
        "chosen": "PostgreSQL 15.x",
        "alternatives_rejected": ["MySQL", "MongoDB"],
        "reason": "JSONB support, full-text search, ACID compliance, strong ecosystem."
      },
      {
        "category": "Cache",
        "chosen": "Redis 7.x",
        "alternatives_rejected": ["Memcached"],
        "reason": "Persistence, pub/sub, sorted sets for future leaderboards."
      },
      {
        "category": "Frontend Framework",
        "chosen": "React 18.x",
        "alternatives_rejected": ["Vue 3", "SvelteKit"],
        "reason": "Team expertise, ecosystem maturity, shadcn/ui availability."
      },
      {
        "category": "Frontend Bundler",
        "chosen": "Vite 5.x",
        "alternatives_rejected": ["webpack", "Parcel"],
        "reason": "HMR speed, ESM-native, TypeScript support."
      },
      {
        "category": "State Management",
        "chosen": "Zustand 4.x (client) + React Query 5.x (server)",
        "alternatives_rejected": ["Redux Toolkit", "Jotai"],
        "reason": "Minimal boilerplate, clear separation of server vs client state."
      },
      {
        "category": "UI Components",
        "chosen": "shadcn/ui + Tailwind CSS 3.x",
        "alternatives_rejected": ["MUI", "Ant Design"],
        "reason": "Copy-paste ownership model, Tailwind-native, accessible by default."
      },
      {
        "category": "Wiki Viewer",
        "chosen": "Next.js 14.x App Router",
        "alternatives_rejected": ["Docusaurus", "GitBook"],
        "reason": "File-system JSON reading, SSG capable, React component reuse."
      }
    ]
  },

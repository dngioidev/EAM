{
  "meta": {
    "version": 1,
    "last_updated": "2025-01-01",
    "title": "Entity State Map",
    "owner": "vibe-ba"
  },
  "quick_facts": {
    "total_state_machines": 2,
    "entities_mapped": ["Order", "Invoice"]
  },
  "content": {
    "tldr": "Defines valid states and transitions for all domain entities with states.",
    "state_machines": [
      {
        "entity": "Order",
        "initial_state": "pending",
        "states": ["pending", "processing", "completed", "cancelled", "refunded"],
        "transitions": [
          { "from": "pending", "to": "processing", "trigger": "payment_received", "actor": ["cashier", "system"] },
          { "from": "processing", "to": "completed", "trigger": "invoice_issued", "actor": ["system"] },
          { "from": "pending", "to": "cancelled", "trigger": "manual_cancel", "actor": ["cashier", "store-manager"] },
          { "from": "processing", "to": "cancelled", "trigger": "payment_failed", "actor": ["system"] },
          { "from": "completed", "to": "refunded", "trigger": "refund_approved", "actor": ["store-manager", "admin"] }
        ],
        "terminal_states": ["cancelled", "refunded"]
      },
      {
        "entity": "Invoice",
        "initial_state": "draft",
        "states": ["draft", "issued", "cancelled"],
        "transitions": [
          { "from": "draft", "to": "issued", "trigger": "order_completed", "actor": ["system"] },
          { "from": "issued", "to": "cancelled", "trigger": "refund_approved", "actor": ["accountant", "admin"] }
        ],
        "terminal_states": ["cancelled"],
        "notes": "Once issued, invoice number is immutable per Vietnamese tax law."
      }
    ]
  },
  "audit": [
    {
      "version": 1,
      "timestamp": "2025-01-01T00:00:00Z",

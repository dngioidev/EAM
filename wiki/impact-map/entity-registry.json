{
  "meta": {
    "version": 1,
    "last_updated": "2025-01-01",
    "title": "Domain Entity Registry",
    "owner": "vibe-ba"
  },
  "quick_facts": {
    "total_entities": 6,
    "db_extensions_required": ["uuid-ossp", "unaccent", "pg_trgm"]
  },
  "content": {
    "entities": [
      {
        "name": "Store",
        "table": "stores",
        "description": "A retail location. All data is scoped to a store.",
        "key_fields": ["id (uuid)", "name", "taxCode", "address", "isActive"],
        "relations": ["User (one-to-many)", "Product (one-to-many)", "Order (one-to-many)"],
        "state_machine": null
      },
      {
        "name": "User",
        "table": "users",
        "description": "Staff member who belongs to one store with one role.",
        "key_fields": ["id (uuid)", "email", "passwordHash", "role", "storeId"],
        "relations": ["Store (many-to-one)"],
        "state_machine": null,
        "roles": ["admin", "store-manager", "cashier", "accountant", "viewer"]
      },
      {
        "name": "Product",
        "table": "products",
        "description": "A product/SKU in a store's inventory.",
        "key_fields": ["id (uuid)", "sku", "name", "priceVnd (integer)", "taxRatePercent", "storeId"],
        "relations": ["Store (many-to-one)", "OrderItem (one-to-many)"],
        "state_machine": null
      },
      {
        "name": "Order",
        "table": "orders",
        "description": "A sales transaction with status lifecycle.",
        "key_fields": ["id (uuid)", "orderNumber", "status", "totalVnd (integer)", "storeId", "cashierId"],
        "relations": ["Store (many-to-one)", "User/cashier (many-to-one)", "OrderItem (one-to-many)", "Invoice (one-to-one)"],
        "state_machine": "Order (see wiki/state-map.json)"
      },
      {
        "name": "OrderItem",
        "table": "order_items",
        "description": "Line item within an order. Stores price snapshot at time of sale.",
        "key_fields": ["id (uuid)", "orderId", "productId", "quantity", "unitPriceVnd (integer)", "taxRatePercent"],
        "relations": ["Order (many-to-one)", "Product (many-to-one)"],
        "state_machine": null
      },
      {
        "name": "Invoice",
        "table": "invoices",
        "description": "Vietnamese electronic invoice (hóa đơn điện tử) issued for a completed order.",
        "key_fields": ["id (uuid)", "invoiceNumber (immutable)", "orderId", "status", "issuedAt"],
        "relations": ["Order (one-to-one)"],
        "state_machine": "Invoice (see wiki/state-map.json)"
      }
    ]
  },
  "audit": [
    {
      "version": 1,
      "timestamp": "2025-01-01T00:00:00Z",
      "author": "vibe-ba",
      "action": "created",
      "note": "Initial 6-entity registry: Store, User, Product, Order, OrderItem, Invoice"
    }
  ]
}

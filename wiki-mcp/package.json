{
  "name": "eam-wiki-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MCP server for EAM-Tax wiki — PostgreSQL-backed tools for AI agent wiki reads/writes",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "node --watch --import=tsx/esm src/server.ts",
    "migrate": "node dist/migrate.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.1",
    "pg": "^8.16.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.15.7",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

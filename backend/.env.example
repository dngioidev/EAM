# ============================================================
# backend/.env.example — copy to .env and fill real values
# ============================================================

# Application
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=eam_user
DATABASE_PASSWORD=change_me
DATABASE_NAME=eam_db
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=true

# Database (test)
DATABASE_TEST_HOST=localhost
DATABASE_TEST_PORT=5433
DATABASE_TEST_USER=eam_user
DATABASE_TEST_PASSWORD=change_me
DATABASE_TEST_NAME=eam_test_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me
REDIS_TTL_REFRESH_TOKEN_SECONDS=604800

# JWT
JWT_SECRET=change_me_to_at_least_64_chars_random_string_here_never_commit_real
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Admin seed (only used by seed:admin script)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=System Admin
